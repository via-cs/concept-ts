      "prototype_id": 1,
      "name": "cold_winter_high_load",
      "description": "Cold winter periods with high heating load, typically during peak demand hours.",
      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        fc = seg.get('forecast_stats', {})\n        temp = lb.get('Skin_temperature', {}).get('mean', 999)\n        load = fc.get('load', {}).get('mean', 0)\n        smonth = lb.get('solar_month', {}).get('mode', 0)\n        if temp < -3 and load > 4000 and smonth in [12, 1, 2]:\n            matched.append(i)\n    return matched"
    },
    {
      "prototype_id": 2,
      "name": "hot_summer_cooling",
      "description": "Hot summer periods with high cooling load and elevated temperatures.",
      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        temp = lb.get('Skin_temperature', {}).get('mean', -999)\n        smonth = lb.get('solar_month', {}).get('mode', 0)\n        humidity = lb.get('Relative_humidity', {}).get('mean', 0)\n        if temp > 25 and smonth in [6, 7, 8] and humidity > 75:\n            matched.append(i)\n    return matched"
    },
    {
      "prototype_id": 3,
      "name": "moderate_spring_workday",
      "description": "Moderate spring weather during workdays with typical business activity.",
      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        temp = lb.get('Skin_temperature', {}).get('mean', -999)\n        is_workday = lb.get('is_workday', {}).get('mode', 0)\n        smonth = lb.get('solar_month', {}).get('mode', 0)\n        if 10 <= temp <= 20 and is_workday == 1 and smonth in [3, 4, 5]:\n            matched.append(i)\n    return matched"
    },
    {
      "prototype_id": 4,
      "name": "mild_autumn_normal",
      "description": "Mild autumn weather with moderate load and comfortable temperatures.",
      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        fc = seg.get('forecast_stats', {})\n        temp = lb.get('Skin_temperature', {}).get('mean', -999)\n        load = fc.get('load', {}).get('mean', 0)\n        smonth = lb.get('solar_month', {}).get('mode', 0)\n        if 15 <= temp <= 25 and 1800 <= load <= 2800 and smonth in [9, 10, 11]:\n            matched.append(i)\n    return matched"
    },
    {
      "prototype_id": 5,
      "name": "holiday_low_demand",
      "description": "Holiday periods with significantly reduced electricity demand.",
      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        fc = seg.get('forecast_stats', {})\n        cross = seg.get('cross_channel_stats', {})\n        is_holiday = lb.get('is_holiday', {}).get('mode', 0)\n        is_workday = lb.get('is_workday', {}).get('mode', 1)\n        load = fc.get('load', {}).get('mean', 9999)\n        contains_holiday = cross.get('contains_holiday', False)\n        if (is_holiday == 1 or contains_holiday) and load < 1800 and is_workday == 0:\n            matched.append(i)\n    return matched"
    },
    {
      "prototype_id": 6,
      "name": "high_wind_variable",
      "description": "High wind conditions with variable weather and moderate load patterns.",
      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        wind = lb.get('10_metre_wind', {}).get('mean', 0)\n        pressure = lb.get('Surface_pressure', {}).get('mean', 101)\n        cloud = lb.get('Total_cloud_cover', {}).get('mean', 0)\n        if wind > 5 and pressure < 100.5 and cloud > 60:\n            matched.append(i)\n    return matched"
    },
    {
      "prototype_id": 7,
      "name": "stable_high_pressure",
      "description": "Stable high pressure weather with clear skies and predictable load.",
      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        pressure = lb.get('Surface_pressure', {}).get('mean', 101)\n        cloud = lb.get('Total_cloud_cover', {}).get('mean', 100)\n        solar = lb.get('Surface_net_solar_radiation', {}).get('mean', 0)\n        humidity = lb.get('Relative_humidity', {}).get('mean', 0)\n        if pressure > 101.0 and cloud < 50 and solar > 150 and humidity < 70:\n            matched.append(i)\n    return matched"
    },
    {
      "prototype_id": 8,
      "name": "transition_shoulder",
