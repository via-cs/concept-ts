      "function": "def select_segments(segments):\n    matched = []\n    for i, seg in enumerate(segments):\n        lb = seg.get('lookback_stats', {})\n        fc = seg.get('forecast_stats', {})\n        temp = lb.get('Skin_temperature', {}).get('mean', -999)\n        load = fc.get('load', {}).get('mean', 0)\n        humidity = lb.get('Relative_humidity', {}).get('mean', 0)\n        if 5 <= temp <= 15 and 1900 <= load <= 2400 and 50 <= humidity <= 75:\n            matched.append(i)\n    return matched"
